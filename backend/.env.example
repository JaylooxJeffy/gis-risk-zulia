# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gis_risk_db
DB_USER=postgres
DB_PASSWORD=

# JWT (genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Correo (Gmail con "contraseña de aplicación")
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Cuenta del administrador principal
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Códigos de acceso (minutos de validez)
CODE_EXPIRATION_MINUTES=10

# Frontend y NASA FIRMS (clave gratuita en firms.modaps.eosdis.nasa.gov/api/map_key)
FRONTEND_URL=http://localhost:5500
FIRMS_MAP_KEY=
